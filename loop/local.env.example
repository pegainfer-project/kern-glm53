# Copied to loop/local.env and filled in; never committed.
GLM_KERN=<kern checkout: tools/, kernel_index/, target/release/kern>
GLM_KERN_BIN=<kern checkout>/target/release/kern
GLM_WEIGHTS=<GLM-5.3 FP8 checkpoint>
GLM_NVCC=<nvcc 13.1.115>
GLM_LIB=<cuda lib64 dirs the bench host loads: CUPTI 13.3 or newer, cuBLASLt>
GLM_LOOP_DATA=<loop state: base/ (main's manifests and reports)>
KERN_CACHE_DIR=<kern blob cache>
GLM_REF=<read-only upstream sources: sglang vllm flashinfer trtllm DeepGEMM>
GLM_SHARED=<shared filesystem root, mounted read-only into the agents' container>
WITHGPU_HOSTS=${WITHGPU_HOSTS:-"<host>"}
WITHGPU_HOST_FORMAT=%s
GLM_TORCH_IMAGE=<a docker image with torch for CUDA 13 on the bench host, for scripts/kern_logits.py>
GLM_KERN_WHEEL=<kern-py wheel built from GLM_KERN (maturin build -m crates/kern-py/Cargo.toml)>
GLM_K31=<kern-k31 checkout, read-only reference>
GLM_ATLAS=<kern-atlas checkout, read-only reference>
GLM_SKILLS=<skills copied into the agents' home (KernelWiki, ncu-report-skill)>
GLM_HUMANIZE=<a ~/.humanize with the ralph_loop flowverse, copied into the agents' home>
GLM_SGLANG_REF=<SGLang's prompt logprobs of the six chat prompts, its fp8-KV run (kern_logits.py's format)>

# The orchestrator only (loop/agents up leaves it out of the agents' copies): its leases go first.
# WITHGPU_FIRST=1
