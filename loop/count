#!/usr/bin/env python3
"""loop/count MANIFEST...: prefill launches in all, and per layer of each kind (dense, MoE with an indexer, MoE sharing)."""
import json
import re
import sys

FULL = {0, 1, 2, 6, 10}
for path in sys.argv[1:]:
    m = json.load(open(path))
    launches = {k: len(v["impl"]["launches"]) for k, v in m["ops"].items()}
    per = {}
    calls = m["programs"]["prefill"]["calls"]
    for c in calls:
        g = re.match(r"L(\d+)\.", c["label"])
        if g and not c["label"].endswith(".plan"):
            per.setdefault(int(g[1]), 0)
            per[int(g[1])] += launches[c["op"]]
    kind = lambda l: "dense" if l < 3 else "moe-full" if l in FULL else "moe-shared"
    avg = {}
    for l, n in per.items():
        avg.setdefault(kind(l), []).append(n)
    print(f"{path}: {sum(launches[c['op']] for c in calls)} launches · "
          + " · ".join(f"{k} {sum(v) / len(v):.1f}/layer" for k, v in avg.items()))
