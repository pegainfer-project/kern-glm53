#!/usr/bin/env bash
# loop/pp A B OUT [N]: the PP4 serving stages, A against B. A and B are scripts/deploy.sh outputs' `p`
# directories (stage0..3.json at serving bounds). Each pair runs A then B (B then A on even pairs) with stage i on
# leased GPU i, all four at once; loop/ppscore sums a shape's four graph p50s (one chunk through the pipeline,
# idle) and weights the grid as loop/score does; the gate reads stage 0, the stage on real inputs (loop/ppscore). No
# projection, no per-call shares. PP_FROM=K runs pairs K..N only, onto an OUT that has the pairs before K.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
a=$(realpath "$1") b=$(realpath "$2") out=$(realpath -m "$3") n=${4:-2}
mkdir -p "$out"
bench="timeout -k 30 1200 env KERN_CACHE_DIR=$KERN_CACHE_DIR LD_LIBRARY_PATH=$LD_LIBRARY_PATH $GLM_KERN_BIN bench \
--kernels $REPO/build --weights $GLM_WEIGHTS --tokenizer $GLM_WEIGHTS/tokenizer.json --workload $LOOP_DIR/workload.toml"
side() {  # side tag pair -> one command running the four stages at once
  local d=$1 x=$2 i=$3 s cmd=""
  for s in 0 1 2 3; do
    cmd+="$bench --gpu $s --manifest $d/stage$s.json --out $out/$x-$i.s$s.json > $out/$x-$i.s$s.log 2>&1 & "
  done
  echo "${cmd}wait"
}
runs=""
for i in $(seq "${PP_FROM:-1}" "$n"); do
  ra="{ $(side "$a" a "$i"); } && " rb="{ $(side "$b" b "$i"); } && "
  ((i % 2)) && runs+="$ra$rb" || runs+="$rb$ra"
done
WITHGPU_GPUS="0 1 2 3" "$LOOP_DIR/withgpu" -n 4 bash -c "${runs}true" || { echo "FAIL run (logs in $out)"; exit 1; }
for x in a b; do for i in $(seq 1 "$n"); do
  for s in 0 1 2 3; do [[ -s $out/$x-$i.s$s.json ]] || { echo "FAIL $x-$i stage $s (log $out/$x-$i.s$s.log)"; exit 1; }; done
done; done
"$LOOP_DIR/ppscore" "$out" "$n"
