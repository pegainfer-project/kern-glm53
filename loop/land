#!/usr/bin/env bash
# loop/land SHA "WHAT" [NOTE]: the orchestrator's merge of one agent commit into this checkout's main.
#
# Cherry-picks SHA without committing (a conflict only in kernels.toml takes SHA's side hunk by hunk), builds and repins, generates the sub-model, A/Bs main's base
# against it (loop/ab, two pairs) and runs the numerics gate against main (loop/longcheck). Prints both. Then,
# only with LAND=1 and the gate passing (all lower by 0.1% or fewer launches, short and long not up beyond 0.3%, longcheck inside
# TASK.md's floor): appends the HISTORY.md row (main's commit it lands after, the row above times the A/B's B/A ratio per scenario,
# Δ all the A/B's own, launches, the gate's long line, NOTE) and commits the pick with SHA's message and author; main's base moves to it
# (manifests, bench report, recordings). Without LAND=1 the pick is left staged for a look; `git reset --hard`
# drops it.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
sha=$1 what=$2 note=${3:-}
base=$GLM_LOOP_DATA/base
cd "$REPO"
[[ -z $(git status --porcelain --untracked-files=no) ]] || { echo "land: the tree is not clean" >&2; exit 1; }
# kernels.toml's pins were the agent's main's; a conflict there takes SHA's side of each conflicting hunk only
# (main's other entries stay), and the build repins on this main (the bench and the gate judge it)
# README.md's conflicts are rows both sides added to its tables: their union, read over before a batch ships
resolve() {  # file, merge-file mode
  local t; t=$(mktemp -d)
  for i in 1 2 3; do git show ":$i:$1" > "$t/$i"; done
  git merge-file "$2" "$t/2" "$t/1" "$t/3"; cp "$t/2" "$1" && git add "$1"
  rm -rf "$t"
}
git cherry-pick -n "$sha" || {
  left=$(git diff --name-only --diff-filter=U | grep -vxE 'kernels.toml|README.md' || true)
  [[ -z $left ]] || { echo "land: conflicts beyond kernels.toml and README.md: $left" >&2; exit 1; }
  git diff --name-only --diff-filter=U | grep -qx kernels.toml && resolve kernels.toml --theirs
  git diff --name-only --diff-filter=U | grep -qx README.md && resolve README.md --union
  true
}
# an entry whose prebuilt or source the tree no longer has (an agent's base kept it, main dropped it) goes
python3 - <<'PY'
import pathlib, re, tomllib
p = pathlib.Path("kernels.toml"); s = p.read_text()
gone = [n for n, k in tomllib.loads(s)["kernels"].items()
        if not pathlib.Path(k.get("prebuilt") or k["source"]).exists()]
for n in gone:
    s = re.sub(r'(?:#[^\n]*\n)*\[kernels\."' + re.escape(n) + r'"\]\n(?:[^\[#\n][^\n]*\n|\n(?=[^\[#]))*\n?', "", s)
    print(f"land: dropped kernels.{n}, its file is gone")
p.write_text(s)
PY
git add kernels.toml
work=$GLM_LOOP_DATA/land/$sha
mkdir -p "$work"
"$LOOP_DIR/build" --update > "$work/build.log" 2>&1 || { tail -3 "$work/build.log"; exit 1; }
"$LOOP_DIR/gen" "$work" | tee "$work/count.txt"
"$LOOP_DIR/ab" "$base/l11.json" "$work/l11.json" "$work/ab" 2 | tee "$work/ab.txt"
"$LOOP_DIR/longcheck" "$work/l11.json" "$work/lc" | tee "$work/lc.txt"
[[ ${LAND:-0} == 1 ]] || { echo "land: staged, not committed (LAND=1 to commit)"; exit 0; }
launches() { grep -oE '[0-9]+ launches' "$1" | head -1 | cut -d' ' -f1; }
"$LOOP_DIR/count" "$base/l11.json" > "$work/count-base.txt" 2>/dev/null || true
python3 - "$work/ab.txt" "$work/lc.txt" "$(launches "$work/count.txt")" "$(launches "$work/count-base.txt")" <<'PY' || { echo "land: held, staged for a look"; exit 1; }
import re, sys
ab, lc = open(sys.argv[1]).read(), open(sys.argv[2]).read()
d = {k: float(v) for k, v in re.findall(r"(short|long|all) [\d.]+ -> [\d.]+ ms \(([-+][\d.]+)%\)", ab)}
floor = {"long": (90.8, 4, 0.075), "short": (94.3, 2, 0.045)}
def within(name):
    m = re.search(rf"^{name} +positions \d+ · top-1 ([\d.]+)% · flips \d+ \(confident (\d+)\) · \|dlp\| mean ([\d.]+)", lc, re.M)
    top1, conf, dlp = floor[name]
    return bool(m) and float(m[1]) >= top1 and int(m[2]) <= conf and float(m[3]) <= dlp
fewer = len(sys.argv) > 3 and int(sys.argv[3]) < int(sys.argv[4])
why = [w for w, bad in [("all not lower by 0.1% (and launches not fewer)", d.get("all", 0) > -0.1 and not fewer), ("short up", d.get("short", 0) > 0.3),
                        ("long up", d.get("long", 0) > 0.3), ("long outside the floor", not within("long")),
                        ("short outside the floor", not within("short"))] if bad]
print("gate: " + ("pass" if not why else "; ".join(why)))
sys.exit(1 if why else 0)
PY

prev=$(grep -E '^\| [0-9]+ \|' "$LOOP_DIR/HISTORY.md" | tail -n 1)
n=$(($(cut -d'|' -f2 <<<"$prev") + 1))
read -r short long all delta < <(python3 "$LOOP_DIR/chain.py" "$work/ab" "$LOOP_DIR" "$prev")
launches=$(grep -oE '[0-9]+ launches' "$work/count.txt" | cut -d' ' -f1)
gate=$(grep -E '^long ' "$work/lc.txt" | sed -E 's/^long +positions [0-9]+ · //; s/ · \|dlp\|.*//')
author=$(git log -1 --format='%an' "$sha")
parent=$(git rev-parse --short HEAD)
echo "| $n | $parent | $what | $short | $long | $all | $delta | $launches | $gate${note:+; $note} |" >> "$LOOP_DIR/HISTORY.md"
git add -A
git commit -q -C "$sha" --signoff
cp "$work/l11.json" "$work/l11c.json" "$base/"
cp "$work/ab/b-1.json" "$base/bench-$n.json"
# the gate's candidate recordings are the new main's: they become the base's, newer than its manifest
for pass in long-c16 short-c3; do cp "$work/lc.$pass.pt" "$base/l11.json.$pass.pt"; done
touch "$base"/l11.json.long-c16.pt "$base"/l11.json.short-c3.pt
echo "land: $(git log -1 --format='%h %s') by $author · row $n · $short / $long / $all ms ($delta)"
