#!/usr/bin/env bash
# loop/agents: the orchestrator's side of the overnight loop.
#
#   loop/agents up NAME HOURS ROUNDFILE   start (or restart) agent NAME
#     (agents lease GLM_AGENT_HOSTS' GPUs, the orchestrator's landings and checks WITHGPU_HOSTS')
#   loop/agents resume NAME HOURS [WHY]   restart NAME in place: its branch, notes and messages kept, a new deadline
#   loop/agents tell NAME MESSAGE         append a message to its ROUND.md
#   loop/agents down [NAME]               stop one agent, or all
#   loop/agents sync                      move the clone's main to this checkout's
#   loop/agents status                    branches, last commits, windows
#
# Agents work in worktrees of a private clone ($GLM_LOOP_DATA/../repo), one branch `agent/NAME` each, never in
# this checkout; they cannot push. Each runs `hmz exec -f ralph_loop` (fresh sessions until HOURS pass) inside one
# shared container, its GPUs leased by loop/withgpu from WITHGPU_HOSTS. The prompt is loop/TASK.md followed by the
# run's ROUND.md: ROUNDFILE (first line: the target), the deadline, the machine's paths and a message section.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
root=$(dirname "$GLM_LOOP_DATA")
clone=$root/repo runs=$root/runs home=$root/.home
container=glm53loop-agents session=glm53loop
image=${GLM_AGENT_IMAGE:-flashkda-dev:cu13.3}
hmz_py=/opt/uv/tools/hmz/bin/python
spec=${GLM_AGENT_SPEC:-claude/claude-opus-5-5:high}
nvcc_root=$(dirname "$(dirname "$GLM_NVCC")")

container_up() {
  docker ps --format '{{.Names}}' | grep -qx $container && return
  docker rm -f $container >/dev/null 2>&1 || true
  mkdir -p "$home/.claude/skills"
  local sk
  for sk in "$GLM_SKILLS"/*/; do rsync -a --exclude .git "$sk" "$home/.claude/skills/$(basename "$sk")/"; done
  [[ -d $home/.humanize ]] || cp -r "$GLM_HUMANIZE" "$home/.humanize"
  docker run -d --name $container --network host --ipc host --cap-add SYS_ADMIN \
    -u "$(id -u):$(id -g)" -e HOME="$home" \
    -v "$GLM_SHARED:$GLM_SHARED:ro" -v "$root:$root" -v "$nvcc_root:$nvcc_root:ro" \
    -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro \
    -v "$HOME/.claude/.credentials.json:$home/.claude/.credentials.json" \
    "$image" sleep infinity >/dev/null
  docker exec -u root $container bash -c 'command -v ssh >/dev/null || { apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openssh-client; } >/dev/null 2>&1'
}

agent_env() {
  grep -vE "^WITHGPU_(FIRST|GPUS|HOSTS)=" "$LOOP_DIR/local.env"
  printf 'WITHGPU_HOSTS="%s"\nWITHGPU_GPUS="%s"\n' "${GLM_AGENT_HOSTS:-$WITHGPU_HOSTS}" "${GLM_AGENT_GPUS:-0 1 2 3}"
}

resume() {
  local name=$1 hours=$2 dir=$runs/$1 deadline
  container_up
  deadline=$(date -u -d "+$(python3 -c "print(round($hours * 60))") minutes" +%FT%T)
  sed -i -E "s/^\*\*Deadline: [^*]+ UTC\*\*/**Deadline: $deadline UTC**/" "$dir/ROUND.md"
  printf 'budget:\n  hours: %s\n' "$hours" > "$dir/.budget.yaml"
  agent_env > "$dir/loop/local.env.new" && mv "$dir/loop/local.env.new" "$dir/loop/local.env"
  tell "$name" "${3:-Restarted (outside cause, not yours).} Your branch, work/ and notes are as you left them; check notes/$name.md and git log, then carry on. Main has moved: rebase first."
  window "$name" "docker exec -it -w $dir $container \
    hmz exec -f ralph_loop -c $dir/.budget.yaml -a $spec \"\$(cat $dir/loop/TASK.md $dir/ROUND.md)\"; exec bash"
}

window() {
  tmux has-session -t $session 2>/dev/null || tmux new-session -d -s $session -n main
  tmux kill-window -t "$session:$1" 2>/dev/null || true
  tmux new-window -d -t $session -n "$1" "$2"
}

paths() {
  printf '\n## Paths on this machine\n\n'
  local v
  for v in GLM_KERN GLM_LOOP_DATA GLM_K31 GLM_ATLAS GLM_REF GLM_WEIGHTS; do printf -- '- `$%s` = `%s`\n' "$v" "${!v}"; done
}

up() {
  local name=$1 hours=$2 roundfile=$3 dir=$runs/$1
  container_up
  [[ -d $clone ]] || { git clone -q "$REPO" "$clone" && git -C "$clone" checkout -q --detach; }
  git -C "$clone" fetch -q "$REPO" main:main
  git -C "$clone" config user.name "$(git -C "$REPO" config user.name)"
  git -C "$clone" config user.email "$(git -C "$REPO" config user.email)"
  if [[ ! -d $dir ]]; then
    git -C "$clone" worktree add -q -b "agent/$name" "$dir" main
    git -C "$dir" submodule update -q --init --recursive
  fi
  agent_env > "$dir/loop/local.env"
  local deadline
  deadline=$(date -u -d "+$hours hours" +%FT%T)
  { head -n 1 "$roundfile"
    printf '\n**Deadline: %s UTC** (`date -u` to compare); the session is killed then.\n' "$deadline"
    paths
    printf '\n## Messages from the orchestrator\n\nRe-read this section at the start of every session; new ones are added here.\n'
    tail -n +2 "$roundfile"; } > "$dir/ROUND.md"
  printf 'budget:\n  hours: %s\n' "$hours" > "$dir/.budget.yaml"
  agent_env > "$dir/loop/local.env.new" && mv "$dir/loop/local.env.new" "$dir/loop/local.env"
  local ex; ex=$(git -C "$dir" rev-parse --git-path info/exclude)
  grep -qx ROUND.md "$ex" 2>/dev/null || printf 'ROUND.md\n.budget.yaml\nloop/local.env\nloop/out/\nwork/\nprofile/\nbuild/\n' >> "$ex"
  docker exec -w "$dir" $container $hmz_py -c 'from hmz.runtime.settings import Settings; Settings().profiles(on=True)'
  window "$name" "docker exec -it -w $dir $container \
    hmz exec -f ralph_loop -c $dir/.budget.yaml -a $spec \"\$(cat $dir/loop/TASK.md $dir/ROUND.md)\"; exec bash"
}

tell() {
  python3 - "$runs/$1/ROUND.md" "$(date -u +%H:%M) UTC: $2" <<'PY'
import sys
p, msg = sys.argv[1], sys.argv[2]
s = open(p).read()
anchor = "Re-read this section at the start of every session; new ones are added here.\n"
open(p, "w").write(s.replace(anchor, anchor + "\n- " + msg + "\n", 1))
PY
}

down() {
  local w
  for w in $(tmux list-windows -t $session -F '#W' 2>/dev/null | grep -vx main); do
    [[ -z ${1:-} || $w == "$1" ]] && tmux kill-window -t "$session:$w"
  done
  # Killing a window leaves its docker exec child running, so the agent is stopped in the container too.
  if [[ -n ${1:-} ]]; then
    docker exec $container pkill -u "$(id -u)" -f "runs/$1/.budget" 2>/dev/null || true
  else
    docker exec $container pkill -u "$(id -u)" -f 'hmz exec|claude' 2>/dev/null || true
  fi
}

status() {
  for d in "$runs"/*/; do
    [[ -d $d ]] || continue
    local n; n=$(basename "$d")
    echo "== $n  $(git -C "$d" log --oneline main..HEAD | wc -l) commits ahead of main"
    git -C "$d" log --format='   %h %cr  %s' -3 main..HEAD
  done
  tmux list-windows -t $session -F '#W #{pane_dead}' 2>/dev/null | grep -vx 'main 0' || true
}

cmd=${1:-status}; shift || true
case $cmd in
  up) up "$@" ;;
  resume) resume "$@" ;;
  tell) tell "$@" ;;
  sync) git -C "$clone" fetch -q "$REPO" main:main ;;
  down) down "$@" ;;
  status) status ;;
  *) sed -n '2,13s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
